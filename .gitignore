# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Manual Reality plate dumps (ARELIS_WALK_SHOTS). Pytest uses tmp_path.
.tmp-reality-walk/
.tmp-reality-walk-live/
.tmp-reality-marks/
.tmp-earth-*/
_tmp_*/
_tmp_*.py
# Agent scratch. Several sittings work this checkout at once and each one
# leaves probes, mutation scripts and pre-edit copies of the files it is
# touching. Ruff honours this file, so an unfinished probe in one lane used
# to fail the pre-commit hook for every other lane. Anything named this way
# is disposable by definition — never put the only copy of something here.
_bk_*
_keep_*
_probe_*
_mutate_*
_verify_*
_cut_*
_unformat_*
_scratch_*
.worktrees/

# Local / secrets
.env
.env.*
!.env.example
secrets/
*.pem

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Editor and agent tooling. Kept on disk because it is useful while working,
# untracked because how this was built is nobody's business but the author's,
# and a published repo answers that question forever.
.cursor/

# Working notes, superseded plans and old audit write-ups. Moved here rather
# than deleted: they are worth keeping and not worth publishing.
.planning/

# How to get her in front of people. Local only. A public repo that
# admits nobody else has run the installer is not a front door.
docs/push.md

# Strips agent attribution out of commit messages. Local for the same reason
# .cursor/ is. The pre-commit hook beside it is tracked on purpose — it runs
# the personal-data guards, and every contributor should get that.
.githooks/prepare-commit-msg

# Arelis runtime
# data/* rather than data/: the directory itself has to stay reachable so the
# profile template below can be tracked. Git cannot un-ignore a file inside an
# ignored directory, only inside an ignored directory's contents.
data/*
!data/profile.example.yaml
!data/secrets.example.yaml
!data/contacts.example.yaml
!data/rooms.example.yaml
!data/calendar.example.ics
!data/lessons.example.yaml
# Chat attachments land under data/drops/ (covered by data/* above).

# Android companion signing. Public repo — a keystore in git is a stolen keystore.
*.jks
*.keystore

# Staged house-served companion APK (scripts/build_companion.py)
companion/*.apk
companion/*.apk.json
companion/*.sha256

# Android companion build outputs
android/**/build/
android/**/.gradle/
android/**/local.properties
android/**/.idea/
logs/
outputs/
# layout ini, active project, and the real profile are all local
*.gguf
models/
!models/**/
!models/**/README.md

# Qt / UI
*.qmlc
*.jsc

# Windows installer build. dist/ and build/ above already match at any depth, which
# covers win-installer/dist/ and win-installer/build/; this is the download cache for
# CPython's embeddable zip. Cached because it is 12MB from python.org on every build,
# untracked because it is a redistributable nobody needs a second copy of, and its
# digest is pinned in build.py so a stale or truncated copy is rejected rather than
# reused.
win-installer/.cache/

# One-off local patches. Not product.
scripts/_patch_globe_*.py

# Wheel unpacked beside the source so the PDF lane could be tried without
# touching the environment. Ignored for the same reason it is excluded from
# ruff: it is a redistributable, not our code.
.tmp_pdfium/

# Homework scans used while building the PDF lane. Not product. One small
# vector-ink fixture lives in tests/fixtures/vector_ink.pdf instead.
physhw/

# Typechecker and audit scratch output. Regenerated on demand.
mypy_out.txt

# Test artifacts. Agent and CI ephemera, not product.
/test_run.log
/TEST_REPORT.md
